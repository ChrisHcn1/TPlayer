{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TPlayer",
  "version": "1.0.2",
  "identifier": "TPlayer.TPlayer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TPlayer",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "devtools": false,
        "decorations": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.music-api.vercel.app https://*.netease.com https://*.qq.com;",
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default capabilities for TPlayer",
          "windows": ["main"],
          "permissions": [
            "dialog:allow-open",
            "dialog:default",
            {
              "identifier": "fs:allow-read-text-file",
              "allow": [{"path": "**/*"}]
            },
            {
              "identifier": "fs:allow-read-file",
              "allow": [{"path": "**/*"}]
            },
            {
              "identifier": "fs:allow-read-dir",
              "allow": [{"path": "**/*"}]
            },
            {
              "identifier": "fs:allow-exists",
              "allow": [{"path": "**/*"}]
            },
            "fs:default",
            "core:webview:default",
            "core:app:default",
            "core:window:allow-show",
            "core:window:allow-hide",
            "core:window:allow-close",
            "core:window:allow-minimize",
            "core:window:allow-maximize",
            "core:window:allow-unmaximize",
            "core:window:allow-set-focus",
            "core:window:allow-is-visible",
            "core:window:allow-start-dragging",
            "core:event:allow-listen",
            "core:event:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.svg",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/Square44x44Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square310x310Logo.png",
      "icons/StoreLogo.png"
    ],
    "resources": [
      "bin/*"
    ],
    "copyright": "2024 TPlayer Team. All rights reserved.",
    "publisher": "CN=4A6BC8B4-7E26-46D4-8F71-B56966D06EB0",
    "shortDescription": "A modern music player with DSD support and advanced lyric features.",
    "longDescription": "TPlayer is a powerful music player designed for audiophiles. Features include:\n\n- High-quality audio playback with DSD support via FFplay\n- Real-time lyrics display with multi-source lyric search\n- Support for multiple audio formats (MP3, FLAC, WAV, AAC, OGG, M4A, WMA, DSD)\n- Beautiful and intuitive user interface with dark/light themes\n- Playlist management and favorites\n- Crossfade and gapless playback\n- Online lyric matching from multiple sources\n- Multi-language support (Chinese, English and more)\n\nExperience the ultimate music listening experience with TPlayer.",

    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      }
    },
    "fileAssociations": [
      {
        "ext": ["mp3", "flac", "wav", "aac", "ogg", "m4a", "wma", "dsf", "dff"],
        "name": "Audio File",
        "description": "Audio file",
        "role": "Viewer"
      }
    ]
  }
}