{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TPlayer",
  "mainBinaryName": "TPlayer",
  "version": "2.0.2",
  "identifier": "com.tplayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3100",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TPlayer",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$AUDIO/**", "$HOME/Music/**", "$APPDATA/cover-cache/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "category": "Music",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "shortDescription": "TPlayer —— 本地优先的桌面音乐播放器",
    "longDescription": "TPlayer 是本地优先的桌面音乐播放器：曲库数据与在线能力解耦，在线模块默认关闭且默认不上传本地曲库信息。基于 Tauri 2、Vue 3 与 Rust 构建，所有曲目数据保存在本机。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bin/ffmpeg.exe": "bin/ffmpeg.exe",
      "../bin/ffprobe.exe": "bin/ffprobe.exe",
      "../bin/sacd_extract.exe": "bin/sacd_extract.exe"
    },
    "fileAssociations": [
      {
        "ext": ["mp3", "flac", "wav", "aac", "ogg", "oga", "opus", "m4a", "wma", "aif", "aiff", "ape", "wv", "tta", "tak", "dsf", "dff", "dts"],
        "name": "TPlayer Audio",
        "description": "音频文件",
        "role": "Viewer"
      }
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEOTI2ODBBRTdBOTkzODIKUldTQ2s2bm5DbWlTSGVMWnUzMG1idU4rL1JQaDJ0ZjVadUZya2h1c21FaGE5SzFmTWt4YlN2RHYK",
      "endpoints": [
        "https://github.com/ChrisHcn1/TPlayer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
