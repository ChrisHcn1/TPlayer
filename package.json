{
  "name": "tplayer-next",
  "private": true,
  "version": "2.0.3",
  "description": "TPlayer - redesigned desktop music player (Tauri 2 + Vue 3 + TypeScript)",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-win.ps1",
    "build:deb": "bash scripts/build-deb.sh",
    "install:deb": "sudo bash scripts/install-deb.sh",
    "uninstall:deb": "sudo bash scripts/uninstall-deb.sh"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "pinia": "^3.0.0",
    "vue": "^3.5.29",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
